#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  # This script runs all the tasks defined in the github workflow action

  puts "== Running brakeman =="
  system! "bin/brakeman --ignore-config config/brakeman.ignore --no-summary --exit-on-warn -q"

  puts "== Running bundler-audit =="
  system! "bin/bundler-audit --update"

  puts "== Running rubocop =="
  system! "bin/rubocop --fail-level A --format clang"

  puts "== Running Archspec =="
  system! "bin/archspec check"

  puts "== Running herb linter =="
  system! "bin/herb lint"

  puts "== Running importmap audit =="
  system! "bin/importmap audit"

  puts "== Resetting test database =="
  system! "bin/rails RAILS_ENV=test db:reset"

  puts "\n== Running test suite =="
  system! "bin/rake"
end
