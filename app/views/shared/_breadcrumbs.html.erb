<%# locals: (current: nil, links: nil) -%>
<nav class="flex py-2" aria-label="Breadcrumb">
  <ol class="flex items-center space-x-4" role="list">
    <% local_assigns[:links]&.each do |content, url| %>
      <li>
        <div class="flex items-center space-x-4">
          <%= link_to content, url, class: "font-semibold link-primary" %>
        </div>
      </li>
    <% end %>

    <% if local_assigns[:current].present? %>
      <li>
        <div class="flex items-center gap-4">
          <% if local_assigns[:links].present? %>
            <%= heroicon "chevron-right", class: "text-stone-900", variant: :mini %>
          <% end %>
          <span aria-current="page" class="font-semibold text-stone-900"><%= local_assigns[:current] %></span>
        </div>
      </li>
    <% end %>
  </ol>
</nav>
