<%# https://ddnexus.github.io/pagy/docs/how-to/#using-your-pagination-templates %>

<%# IMPORTANT: use '<%== ... ' instead of '<%= ... ' if you run this in rails %>

<%# The a variable below is set to a lambda that generates the a tag %>
<%# Usage: a_tag = a.(page_number, text, classes: nil, aria_label: nil) %>
<% a = pagy.send(:a_lambda) %>

<nav class="isolate inline-flex -space-x-px rounded-md shadow-sm bg-white" aria-label="Pagination">
  <%# Previous page link %>
  <% if pagy.previous %>
    <%= a.(pagy.previous, '&larr;', classes: "relative inline-flex items-center rounded-l-md px-4 py-2 text-stone-400 hover:text-sky-500 ring-1 ring-inset ring-stone-300 hover:bg-stone-50 focus:z-20 focus:outline-offset-0", aria_label: 'Previous').html_safe %>
  <% else %>
    <a role="link" aria-disabled="true" aria-label="Previous" class="relative inline-flex items-center rounded-l-md px-4 py-2 text-stone-400 ring-1 ring-inset ring-stone-300 hover:bg-stone-50 focus:z-20 focus:outline-offset-0">&larr;</a>
  <% end %>
  <%# Page links (series example: [1, :gap, 7, 8, "9", 10, 11, :gap, 36]) %>
  <% pagy.send(:series).each do |item| %>
    <% if item.is_a?(Integer) %>
      <%= a.(item, classes: "relative inline-flex items-center px-4 py-2 text-sm font-medium text-stone-700 hover:text-sky-500 ring-1 ring-inset ring-stone-300 hover:bg-stone-50 focus:z-20 focus:outline-offset-0").html_safe %>
    <% elsif item.is_a?(String) %>
      <a role="link" aria-disabled="true" aria-current="page" class="relative inline-flex items-center px-4 py-2 text-sm font-medium z-10 bg-sky-600 text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600"><%= item %></a>
    <% elsif item == :gap %>
      <span class="relative inline-flex items-center px-4 py-2 text-sm font-medium text-stone-700 ring-1 ring-inset ring-stone-300 focus:outline-offset-0">...</span>
    <% end %>
  <% end %>
  <%# Next page link %>
  <% if pagy.next %>
    <%= a.(pagy.next, "&rarr;", aria_label: 'Next', classes: "relative inline-flex items-center rounded-r-md px-4 py-2 text-stone-400 hover:text-sky-500 ring-1 ring-inset ring-stone-300 hover:bg-stone-50 focus:z-20 focus:outline-offset-0").html_safe %>
  <% else %>
    <a role="link" aria-disabled="true" aria-label="Next" class="relative inline-flex items-center rounded-r-md px-4 py-2 text-stone-400 ring-1 ring-inset ring-stone-300 hover:bg-stone-50 focus:z-20 focus:outline-offset-0">&rarr;</a>
  <% end %>
</nav>
