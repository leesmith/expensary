<% if @accounts.any? %>
  <div class="flex justify-end align-center mb-4">
    <button command="show-modal" commandfor="new-account" class="gap-x-1.5 btn btn-primary">
      <%= heroicon "plus", class: "-ml-0.5 size-5", variant: :mini %>
      Add Account
    </button>
  </div>
  <div class="flex">
    <div class="xl:w-2/3 w-full">
      <ul role="list" class="divide-y divide-stone-100 overflow-hidden bg-white shadow-sm ring-1 ring-stone-900/5 sm:rounded-lg">
        <% @accounts.each do |account| %>
          <li class="relative flex justify-between gap-x-6 px-4 py-5 hover:bg-stone-50 sm:px-6">
            <div class="flex min-w-0 gap-x-4">
              <div class="min-w-0 flex-auto">
                <p class="text-md/6 font-semibold text-stone-900">
                  <%= link_to account do %>
                    <span class="absolute inset-x-0 -top-px bottom-0"></span>
                    <%= account.name %>
                  <% end %>
                </p>
                <p class="mt-1 flex text-xs/5 text-stone-500"><%= account.description %></p>
              </div>
            </div>
            <div class="flex shrink-0 items-center gap-x-4">
              <div class="hidden sm:flex sm:flex-col sm:items-end">
                <p>
                  <% if account.liability_account_type? %>
                    <span class="inline-flex items-center rounded-md bg-red-50 px-2 py-1 text-xs font-medium text-red-700 inset-ring inset-ring-red-600/10">Liability</span>
                  <% else %>
                    <span class="inline-flex items-center rounded-md bg-green-50 px-2 py-1 text-xs font-medium text-green-700 inset-ring inset-ring-green-600/20">Asset</span>
                  <% end %>
                </p>
                <p class="mt-2 text-xs/5 text-stone-500">
                  Latest transaction on <%= word_date account.latest_transaction&.tran_date %>
                </p>
              </div>
              <svg viewBox="0 0 20 20" fill="currentColor" data-slot="icon" aria-hidden="true" class="size-5 flex-none text-stone-400">
                <path d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" fill-rule="evenodd" />
              </svg>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
<% else %>
  <div class="flex justify-center">
    <div class="w-full xl:w-2/3 p-6 rounded-lg border-2 border-dashed border-stone-300 text-center">
      <h3 class="mt-2 text-sm font-semibold text-stone-900">No accounts</h3>
      <p class="mt-1 text-sm text-stone-500">Add your liability and asset accounts in order to load transactions.</p>
      <div class="mt-6">
        <button command="show-modal" commandfor="new-account" class="gap-x-1.5 btn btn-primary">
          <%= heroicon "plus", class: "-ml-0.5 size-5", variant: :mini %>
          Add Account
        </button>
      </div>
    </div>
  </div>
<% end %>
<el-dialog>
  <dialog id="new-account" aria-labelledby="drawer-title" class="fixed inset-0 size-auto max-h-none max-w-none overflow-hidden bg-transparent not-open:hidden backdrop:bg-transparent">
    <el-dialog-backdrop class="absolute inset-0 bg-stone-500/75 transition-opacity duration-500 ease-in-out data-closed:opacity-0"></el-dialog-backdrop>
    <div tabindex="0" class="absolute inset-0 pl-10 focus:outline-none sm:pl-16">
      <el-dialog-panel class="ml-auto block size-full max-w-md transform transition duration-500 ease-in-out data-closed:translate-x-full sm:duration-700">
        <div class="relative flex h-full flex-col overflow-y-auto bg-white py-6 shadow-xl">
          <div class="px-4 sm:px-6">
            <div class="flex items-start justify-between">
              <h2 id="drawer-title" class="text-base font-semibold text-stone-900">Add Account</h2>
              <div class="ml-3 flex h-7 items-center">
                <button type="button" command="close" commandfor="new-account" class="relative p-1 rounded-md text-stone-400 hover:text-stone-500 hover:bg-stone-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600">
                  <span class="absolute -inset-2.5"></span>
                  <span class="sr-only">Close panel</span>
                  <%= heroicon "x-mark", class: "size-6" %>
                </button>
              </div>
            </div>
          </div>
          <div class="relative mt-6 flex-1 px-4 sm:px-6">
            <div>
              <%= form_with model: Account.new, url: accounts_path, method: :post, class: "my-4 space-y-4" do |form| %>
                <div class="mt-2">
                  <%= form.label :name, class: "form-label mr-2" %>
                  <div class="mt-1">
                    <%= form.text_field :name, required: true, class: "text-field" %>
                  </div>
                </div>
                <div class="mt-2">
                  <%= form.label :description, class: "form-label mr-2" %>
                  <div class="mt-1">
                    <%= form.text_field :description, class: "text-field" %>
                  </div>
                </div>
                <fieldset>
                  <legend class="text-sm/6 font-semibold text-stone-900">Account Type</legend>
                  <div class="mt-2 space-y-6 sm:flex sm:items-center sm:space-y-0 sm:space-x-10">
                    <% Account.account_types.each do |account_type| %>
                      <div class="flex items-center">
                        <%= form.radio_button :account_type, account_type.first, class: "relative size-4 appearance-none rounded-full border border-stone-300 bg-white before:absolute before:inset-1 before:rounded-full before:bg-white not-checked:before:hidden checked:border-sky-600 checked:bg-sky-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 disabled:border-stone-300 disabled:bg-stone-100 disabled:before:bg-stone-400 forced-colors:appearance-auto forced-colors:before:hidden" %>
                        <label class="form-label ml-3" for="account_account_type_<%= account_type.first %>"><%= account_type.first.titleize %></label>
                      </div>
                    <% end %>
                  </div>
                </fieldset>
                <div class="pt-5 border-t border-stone-200">
                  <div class="flex justify-end">
                    <%= form.submit "Save", class: "btn btn-primary" %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </el-dialog-panel>
    </div>
  </dialog>
</el-dialog>
