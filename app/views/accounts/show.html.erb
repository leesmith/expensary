<div class="flex justify-between items-center">
  <%= render "shared/breadcrumbs", current: @account.name, links: [
    [ "Accounts", accounts_url ],
  ] %>
  <div class="my-4 text-sm font-medium text-sky-500 hover:text-sky-700">
    <%== render partial: "shared/pagination", locals: { pagy: @pagy } %>
  </div>
</div>

<div class="flow-root">
  <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
    <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
      <%= render "shared/card", class: "" do %>
        <table class="relative min-w-full divide-y divide-zinc-300">
          <thead class="bg-zinc-50">
            <tr>
              <th scope="col" class="py-3.5 pr-3 pl-4 text-left text-sm font-semibold text-zinc-900 sm:pl-6">Date</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-zinc-900">Amount</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-zinc-900">Account</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-zinc-900">Category</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-zinc-900">Description</th>
              <th scope="col" class="py-3.5 pr-4 pl-3 sm:pr-6">
                <span class="sr-only">Actions</span>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-200 bg-white">
            <tr>
              <td colspan="6">
                <div class="flex justify-end align-center p-2">
                  <button command="show-modal" commandfor="new-transaction" class="gap-x-1.5 btn btn-primary">
                    <%= heroicon "plus", class: "-ml-0.5 size-5", variant: :mini %>
                    Add Transaction
                  </button>
                </div>
                <el-dialog>
                  <dialog id="new-transaction" aria-labelledby="drawer-title" class="fixed inset-0 size-auto max-h-none max-w-none overflow-hidden bg-transparent not-open:hidden backdrop:bg-transparent">
                    <el-dialog-backdrop class="absolute inset-0 bg-zinc-500/75 transition-opacity duration-500 ease-in-out data-closed:opacity-0"></el-dialog-backdrop>
                    <div tabindex="0" class="absolute inset-0 pl-10 focus:outline-none sm:pl-16">
                      <el-dialog-panel class="ml-auto block size-full max-w-md transform transition duration-500 ease-in-out data-closed:translate-x-full sm:duration-700">
                        <div class="relative flex h-full flex-col overflow-y-auto bg-white py-6 shadow-xl">
                          <div class="px-4 sm:px-6">
                            <div class="flex items-start justify-between">
                              <h2 id="drawer-title" class="text-base font-semibold text-zinc-900">Add Transaction</h2>
                              <div class="ml-3 flex h-7 items-center">
                                <button type="button" command="close" commandfor="new-transaction" class="relative p-1 rounded-md text-zinc-400 hover:text-zinc-500 hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600">
                                  <span class="absolute -inset-2.5"></span>
                                  <span class="sr-only">Close panel</span>
                                  <%= heroicon "x-mark", class: "size-6" %>
                                </button>
                              </div>
                            </div>
                          </div>
                          <div class="relative mt-6 flex-1 px-4 sm:px-6">
                            <div>
                              <%= form_with(url: account_transactions_url(@account), scope: :transaction) do |form| %>
                                <div class="space-y-8">
                                  <div class="mt-6 grid grid-cols-1 gap-y-6 gap-x-4">
                                    <div>
                                      <%= form.label :tran_date, "Transaction Date", class: "form-label" %>
                                      <div class="mt-1">
                                        <%= form.date_field :tran_date, max: Date.today, required: true, class: "text-field" %>
                                      </div>
                                    </div>
                                    <div>
                                      <%= form.label :category, class: "form-label" %>
                                      <div class="mt-1">
                                        <%= form.select :category_id, raw(grouped_category_options(Category.order(:group_title, :title))), { include_blank: true }, required: true, class: "text-field" %>
                                      </div>
                                    </div>
                                    <div>
                                      <%= form.label :description, class: "form-label" %>
                                      <div class="mt-1">
                                        <%= form.text_field :description, required: true, class: "text-field" %>
                                      </div>
                                    </div>
                                    <div>
                                      <%= form.label :amount, class: "form-label" %>
                                      <div class="mt-1">
                                        <%= form.number_field :amount, step: 0.01, required: true, class: "text-field" %>
                                      </div>
                                    </div>
                                  </div>
                                  <div class="mt-2 space-y-6 sm:flex sm:items-center sm:space-y-0 sm:space-x-10">
                                    <div class="flex items-center">
                                      <%= form.radio_button :tran_type, "debit", checked: true, class: "relative size-4 appearance-none rounded-full border border-zinc-300 bg-white before:absolute before:inset-1 before:rounded-full before:bg-white not-checked:before:hidden checked:border-sky-600 checked:bg-sky-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 disabled:border-zinc-300 disabled:bg-zinc-100 disabled:before:bg-zinc-400 forced-colors:appearance-auto forced-colors:before:hidden" %>
                                      <label for="transaction_tran_type_debit" class="ml-3 form-label">Debit</label>
                                    </div>
                                    <div class="flex items-center">
                                      <%= form.radio_button :tran_type, "credit", class: "relative size-4 appearance-none rounded-full border border-zinc-300 bg-white before:absolute before:inset-1 before:rounded-full before:bg-white not-checked:before:hidden checked:border-sky-600 checked:bg-sky-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 disabled:border-zinc-300 disabled:bg-zinc-100 disabled:before:bg-zinc-400 forced-colors:appearance-auto forced-colors:before:hidden" %>
                                      <label for="transaction_tran_type_credit" class="ml-3 form-label">Credit</label>
                                    </div>
                                  </div>
                                  <div class="pt-5 border-t border-zinc-200">
                                    <div class="flex justify-end">
                                      <%= form.submit "Save", class: "inline-flex justify-center btn btn-primary" %>
                                    </div>
                                  </div>
                                </div>
                              <% end %>
                            </div>
                          </div>
                        </div>
                      </el-dialog-panel>
                    </div>
                  </dialog>
                </el-dialog>
              </td>
            </tr>
            <% @transactions.each do |tran| %>
              <tr>
                <td class="py-4 pr-3 pl-4 text-sm font-medium whitespace-nowrap text-zinc-900 sm:pl-6"><%= word_date tran.tran_date %></td>
                <td class="px-3 py-4 text-sm whitespace-nowrap <%= tran.credit? ? "text-green-700" : "text-zinc-500" %>"><%= number_to_currency tran.amount %></td>
                <td class="px-3 py-4 text-sm whitespace-nowrap text-zinc-500"><%= tran.account.name %></td>
                <td class="px-3 py-4 text-sm whitespace-nowrap text-zinc-500"><%= tran.category&.title %></td>
                <td class="px-3 py-4 text-sm text-zinc-500"><%= truncate(tran.description, length: 60) %></td>
                <td class="py-4 pr-4 pl-3 text-right text-sm font-medium sm:pr-6">
                  <div class="flex justify-end items-center">
                    <%= link_to "#", class: "link-primary text-sm pr-4" do %>
                      <%= heroicon "pencil-square", class: "size-6 shrink-0" %>
                    <% end %>
                    <button command="show-modal" commandfor="delete_<%= dom_id(tran) %>" class="link-primary text-red-700 hover:text-red-500 hover:cursor-pointer text-sm">
                      <%= heroicon "trash", class: "size-6 shrink-0" %>
                    </button>
                    <el-dialog>
                      <dialog id="delete_<%= dom_id(tran) %>" aria-labelledby="dialog-title" class="fixed inset-0 size-auto max-h-none max-w-none overflow-y-auto bg-transparent backdrop:bg-transparent">
                        <el-dialog-backdrop class="fixed inset-0 bg-gray-500/75 transition-opacity data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in"></el-dialog-backdrop>
                        <div tabindex="0" class="flex min-h-full items-end justify-center p-4 text-center focus:outline-none sm:items-center sm:p-0">
                          <el-dialog-panel class="relative transform overflow-hidden rounded-lg bg-white px-4 pt-5 pb-4 text-left shadow-xl transition-all data-closed:translate-y-4 data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in sm:my-8 sm:w-full sm:max-w-lg sm:p-6 data-closed:sm:translate-y-0 data-closed:sm:scale-95">
                            <div class="sm:flex sm:items-start">
                              <div class="mx-auto flex size-12 shrink-0 items-center justify-center rounded-full bg-red-100 sm:mx-0 sm:size-10">
                                <%= heroicon "exclamation-triangle", class: "size-6 text-red-600" %>
                              </div>
                              <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
                                <h3 id="dialog-title" class="text-base font-semibold text-gray-900">Delete transaction</h3>
                                <div class="mt-2">
                                  <p class="text-sm text-zinc-500">Are you sure you want to delete this transaction? This action cannot be undone.</p>
                                </div>
                              </div>
                            </div>
                            <div class="mt-5 sm:mt-4 sm:flex sm:flex-row-reverse">
                              <%= link_to "Delete", account_transaction_url(@account, tran), class: "inline-flex w-full justify-center btn btn-danger sm:ml-3 sm:w-auto", data: { turbo_method: :delete } %>
                              <button type="button" command="close" commandfor="delete_<%= dom_id(tran) %>" class="mt-3 inline-flex w-full justify-center btn btn-secondary sm:mt-0 sm:w-auto">
                                Cancel
                              </button>
                            </div>
                          </el-dialog-panel>
                        </div>
                      </dialog>
                    </el-dialog>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  </div>
</div>

<div class="flex justify-end">
  <div class="my-4 text-sm font-medium text-sky-500 hover:text-sky-700">
    <%== render partial: "shared/pagination", locals: { pagy: @pagy } %>
  </div>
</div>
