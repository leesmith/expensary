<div class="lg:flex lg:gap-8">
  <div class="lg:w-2/3">
    <% if @categories.any? %>
      <ul role="list" class="divide-y divide-zinc-100 overflow-hidden bg-white shadow-sm ring-1 ring-zinc-900/5 sm:rounded-lg">
        <% @categories.each do |category| %>
          <li class="relative flex justify-between gap-x-6 px-4 py-5 hover:bg-zinc-50 sm:px-6">
            <div class="flex min-w-0 gap-x-4">
              <div class="min-w-0 flex-auto">
                <p class="text-md/6 font-semibold text-zinc-900">
                  <%= link_to account do %>
                    <span class="absolute inset-x-0 -top-px bottom-0"></span>
                    <%= account.name %>
                  <% end %>
                </p>
                <p class="mt-1 flex text-xs/5 text-zinc-500"><%= account.description %></p>
              </div>
            </div>
            <div class="flex shrink-0 items-center gap-x-4">
              <div class="hidden sm:flex sm:flex-col sm:items-end">
                <% if account.liability_account_type? %>
                  <span class="inline-flex items-center rounded-md bg-red-50 px-2 py-1 text-xs font-medium text-red-700 inset-ring inset-ring-red-600/10">Liability</span>
                <% else %>
                  <span class="inline-flex items-center rounded-md bg-green-50 px-2 py-1 text-xs font-medium text-green-700 inset-ring inset-ring-green-600/20">Asset</span>
                <% end %>
              </div>
              <svg viewBox="0 0 20 20" fill="currentColor" data-slot="icon" aria-hidden="true" class="size-5 flex-none text-zinc-400">
                <path d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" fill-rule="evenodd" />
              </svg>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="p-6 rounded-lg border-2 border-dashed border-zinc-300 text-center">
        <h3 class="mt-2 text-lg font-semibold text-zinc-900">Add your categories</h3>
        <p class="mt-1 text-sm text-zinc-500">Add your categories in order to track your spending.</p>
      </div>
    <% end %>
  </div>

  <div class="lg:w-1/3">
    <%= render "shared/card", class: "divide-y divide-zinc-200 p-4 mt-4 lg:mt-0" do %>
      <p class="pb-2 font-medium text-zinc-900">Add Category</p>
      <%= form_with model: Category.new, url: categories_path, method: :post, class: "my-4 space-y-4" do |f| %>
        <div class="mt-2">
          <%= f.label :group_title, class: "form-label mr-2" %>
          <div class="mt-1">
            <%= f.text_field :group_title, required: true, class: "text-field" %>
          </div>
        </div>
        <div class="mt-2">
          <%= f.label :title, class: "form-label mr-2" %>
          <div class="mt-1">
            <%= f.text_field :title, class: "text-field" %>
          </div>
        </div>
        <div class="flex justify-end">
          <%= f.submit "Add", class: "btn btn-primary" %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
