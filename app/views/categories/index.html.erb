<% if @categories.any? %>
  <div class="flex justify-end align-center mb-4">
    <button command="show-modal" commandfor="new-category" class="gap-x-1.5 btn btn-primary">
      <%= heroicon "plus", class: "-ml-0.5 size-5", variant: :mini %>
      Add Category
    </button>
  </div>
  <div class="flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <%= render "shared/card", class: "" do %>
          <table class="relative min-w-full divide-y divide-zinc-300">
            <tbody class="divide-y divide-zinc-200 bg-white">
              <% @categories.map(&:group_title).uniq.each do |group| %>
                <tr class="bg-sky-600">
                  <th scope="col" class="py-3.5 pr-3 pl-4 text-left font-semibold text-white sm:pl-6">
                    <%= group %>
                  </th>
                  <th scope="col" class="py-3.5 pr-4 pl-3 sm:pr-6">
                    <span class="sr-only">Actions</span>
                  </th>
                </tr>
                <% @categories.select {|c| c.group_title == group}.each do |category| %>
                  <tr class="group/action hover:bg-zinc-50">
                    <td class="py-4 pr-3 pl-4 text-sm font-medium whitespace-nowrap text-zinc-900 sm:pl-6"><%= category.title %></td>
                    <td class="py-4 pr-4 pl-3 sm:pr-6">
                      <div class="flex justify-end items-center text-right invisible group-hover/action:visible">
                        <button command="show-modal" commandfor="edit_<%= dom_id(category) %>" class="link-primary hover:cursor-pointer pr-4">
                          <%= heroicon "pencil-square", class: "size-6 shrink-0" %>
                        </button>
                        <button command="show-modal" commandfor="delete_<%= dom_id(category) %>" class="link-primary text-red-700 hover:text-red-500 hover:cursor-pointer text-sm">
                          <%= heroicon "trash", class: "size-6 shrink-0" %>
                        </button>
                      </div>
                      <el-dialog>
                        <dialog id="edit_<%= dom_id(category) %>" aria-labelledby="drawer-title" class="fixed inset-0 size-auto max-h-none max-w-none overflow-hidden bg-transparent not-open:hidden backdrop:bg-transparent">
                          <el-dialog-backdrop class="absolute inset-0 bg-zinc-500/75 transition-opacity duration-500 ease-in-out data-closed:opacity-0"></el-dialog-backdrop>
                          <div tabindex="0" class="absolute inset-0 pl-10 focus:outline-none sm:pl-16">
                            <el-dialog-panel class="ml-auto block size-full max-w-md transform transition duration-500 ease-in-out data-closed:translate-x-full sm:duration-700">
                              <div class="relative flex h-full flex-col overflow-y-auto bg-white py-6 shadow-xl">
                                <div class="px-4 sm:px-6">
                                  <div class="flex items-start justify-between">
                                    <h2 id="drawer-title" class="text-base font-semibold text-zinc-900">Edit Category</h2>
                                    <div class="ml-3 flex h-7 items-center">
                                      <button type="button" command="close" commandfor="edit_<%= dom_id(category) %>" class="relative p-1 rounded-md text-zinc-400 hover:text-zinc-500 hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600">
                                        <span class="absolute -inset-2.5"></span>
                                        <span class="sr-only">Close panel</span>
                                        <%= heroicon "x-mark", class: "size-6" %>
                                      </button>
                                    </div>
                                  </div>
                                </div>
                                <div class="relative mt-6 flex-1 px-4 sm:px-6">
                                  <div>
                                    <%= form_with model: category, url: category, scope: :category, class: "my-4 space-y-4" do |form| %>
                                      <div class="mt-2">
                                        <%= form.label :group_title, class: "form-label mr-2" %>
                                        <div class="mt-1">
                                          <%= form.text_field :group_title, required: true, class: "text-field" %>
                                        </div>
                                      </div>
                                      <div class="mt-2">
                                        <%= form.label :title, class: "form-label mr-2" %>
                                        <div class="mt-1">
                                          <%= form.text_field :title, class: "text-field" %>
                                        </div>
                                      </div>
                                      <div class="pt-5 border-t border-zinc-200">
                                        <div class="flex justify-end">
                                          <%= form.submit "Save", class: "btn btn-primary" %>
                                        </div>
                                      </div>
                                    <% end %>
                                  </div>
                                </div>
                              </div>
                            </el-dialog-panel>
                          </div>
                        </dialog>
                      </el-dialog>
                      <el-dialog>
                        <dialog id="delete_<%= dom_id(category) %>" aria-labelledby="dialog-title" class="fixed inset-0 size-auto max-h-none max-w-none overflow-y-auto bg-transparent backdrop:bg-transparent">
                          <el-dialog-backdrop class="fixed inset-0 bg-gray-500/75 transition-opacity data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in"></el-dialog-backdrop>
                          <div tabindex="0" class="flex min-h-full items-end justify-center p-4 text-center focus:outline-none sm:items-center sm:p-0">
                            <el-dialog-panel class="relative transform overflow-hidden rounded-lg bg-white px-4 pt-5 pb-4 text-left shadow-xl transition-all data-closed:translate-y-4 data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in sm:my-8 sm:w-full sm:max-w-lg sm:p-6 data-closed:sm:translate-y-0 data-closed:sm:scale-95">
                              <div class="sm:flex sm:items-start">
                                <div class="mx-auto flex size-12 shrink-0 items-center justify-center rounded-full bg-red-100 sm:mx-0 sm:size-10">
                                  <%= heroicon "exclamation-triangle", class: "size-6 text-red-600" %>
                                </div>
                                <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
                                  <h3 id="dialog-title" class="text-base font-semibold text-gray-900">Delete category</h3>
                                  <div class="mt-2">
                                    <p class="text-sm text-zinc-500">
                                      Are you sure you want to delete this category? All transactions that are categorized as "<%= category.group_title %> - <%= category.title %>" will now be uncategorized. This action cannot be undone.
                                    </p>
                                  </div>
                                </div>
                              </div>
                              <div class="mt-5 sm:mt-4 sm:flex sm:flex-row-reverse">
                                <%= link_to "Delete", category, class: "inline-flex w-full justify-center btn btn-danger sm:ml-3 sm:w-auto", data: { turbo_method: :delete } %>
                                <button type="button" command="close" commandfor="delete_<%= dom_id(category) %>" class="mt-3 inline-flex w-full justify-center btn btn-secondary sm:mt-0 sm:w-auto">
                                  Cancel
                                </button>
                              </div>
                            </el-dialog-panel>
                          </div>
                        </dialog>
                      </el-dialog>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        <% end %>
      </div>
    </div>
  </div>
<% else %>
  <div class="flex justify-center">
    <div class="w-full xl:w-2/3 p-6 rounded-lg border-2 border-dashed border-zinc-300 text-center">
      <h3 class="mt-2 text-sm font-semibold text-gray-900">No categories</h3>
      <p class="mt-1 text-sm text-zinc-500">Add your categories so that income and expense transactions can be tracked.</p>
      <div class="mt-6">
        <button command="show-modal" commandfor="new-category" class="gap-x-1.5 btn btn-primary">
          <%= heroicon "plus", class: "-ml-0.5 size-5", variant: :mini %>
          Add Category
        </button>
      </div>
    </div>
  </div>
<% end %>

<el-dialog>
  <dialog id="new-category" aria-labelledby="drawer-title" class="fixed inset-0 size-auto max-h-none max-w-none overflow-hidden bg-transparent not-open:hidden backdrop:bg-transparent">
    <el-dialog-backdrop class="absolute inset-0 bg-zinc-500/75 transition-opacity duration-500 ease-in-out data-closed:opacity-0"></el-dialog-backdrop>
    <div tabindex="0" class="absolute inset-0 pl-10 focus:outline-none sm:pl-16">
      <el-dialog-panel class="ml-auto block size-full max-w-md transform transition duration-500 ease-in-out data-closed:translate-x-full sm:duration-700">
        <div class="relative flex h-full flex-col overflow-y-auto bg-white py-6 shadow-xl">
          <div class="px-4 sm:px-6">
            <div class="flex items-start justify-between">
              <h2 id="drawer-title" class="text-base font-semibold text-zinc-900">Add Category</h2>
              <div class="ml-3 flex h-7 items-center">
                <button type="button" command="close" commandfor="new-category" class="relative p-1 rounded-md text-zinc-400 hover:text-zinc-500 hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600">
                  <span class="absolute -inset-2.5"></span>
                  <span class="sr-only">Close panel</span>
                  <%= heroicon "x-mark", class: "size-6" %>
                </button>
              </div>
            </div>
          </div>
          <div class="relative mt-6 flex-1 px-4 sm:px-6">
            <div>
              <%= form_with model: Category.new, url: categories_path, class: "my-4 space-y-4" do |form| %>
                <div class="mt-2">
                  <%= form.label :group_title, class: "form-label mr-2" %>
                  <div class="mt-1">
                    <%= form.text_field :group_title, required: true, class: "text-field" %>
                  </div>
                </div>
                <div class="mt-2">
                  <%= form.label :title, class: "form-label mr-2" %>
                  <div class="mt-1">
                    <%= form.text_field :title, class: "text-field" %>
                  </div>
                </div>
                <div class="pt-5 border-t border-zinc-200">
                  <div class="flex justify-end">
                    <%= form.submit "Save", class: "btn btn-primary" %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </el-dialog-panel>
    </div>
  </dialog>
</el-dialog>
