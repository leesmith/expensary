<div class="lg:flex lg:gap-8">
  <div class="lg:w-2/3">
    <% if @categories.any? %>
      <div class="flow-root">
        <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
          <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
            <%= render "shared/card", class: "" do %>
              <table class="relative min-w-full divide-y divide-zinc-300">
                <tbody class="divide-y divide-zinc-200 bg-white">
                  <%- @categories.map(&:group_title).uniq.each do |group| %>
                    <tr class="text-sm/6 text-zinc-900 bg-zinc-100">
                      <th scope="col" class="py-3.5 pr-3 pl-4 text-left text-md font-semibold text-zinc-900 sm:pl-6">
                        <%= group %>
                      </th>
                    </tr>
                    <%- @categories.select {|c| c.group_title == group}.each do |category| %>
                      <tr>
                        <td class="py-4 pr-3 pl-4 text-sm font-medium whitespace-nowrap text-zinc-900 sm:pl-6">
                          <%= category.title %>
                        </td>
                      </tr>
                    <% end %>
                  <% end %>
                </tbody>
              </table>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="lg:w-1/3">
    <%= render "shared/card", class: "divide-y divide-zinc-200 p-4 mt-4 lg:mt-0" do %>
      <p class="pb-2 font-medium text-zinc-900">Add Category</p>
      <%= form_with model: Category.new, url: categories_path, method: :post, class: "my-4 space-y-4" do |f| %>
        <div class="mt-2">
          <%= f.label :group_title, class: "form-label mr-2" %>
          <div class="mt-1">
            <%= f.text_field :group_title, required: true, class: "text-field" %>
          </div>
        </div>
        <div class="mt-2">
          <%= f.label :title, class: "form-label mr-2" %>
          <div class="mt-1">
            <%= f.text_field :title, class: "text-field" %>
          </div>
        </div>
        <div class="flex justify-end">
          <%= f.submit "Add", class: "btn btn-primary" %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
