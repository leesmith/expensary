<div class="mb-2">
  <%= form_with url: transactions_url, method: :get, class: "py-2" do |form| %>
    <div class="grid grid-cols-1 gap-y-3 gap-x-4 sm:grid-cols-12">
      <div class="sm:col-span-3">
        <%= form.select :account_id, options_from_collection_for_select(@accounts, "id", "name", params[:account_id]), { prompt: "-- Account --" }, onChange: "this.form.submit();", class: "text-field" %>
      </div>
      <div class="sm:col-span-3">
        <%= form.select :category_id, grouped_options_for_select(@categories.group_by(&:group_title).transform_values { |cats| cats.map { |c| [c.title, c.id] } }, params[:category_id].to_i), { prompt: "-- Category --" }, onChange: "this.form.submit();", class: "text-field" %>
      </div>
    </div>
  <% end %>
</div>

<div class="flow-root">
  <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
    <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
      <div class="overflow-hidden shadow-sm outline-1 outline-black/5 sm:rounded-lg">
        <table class="relative min-w-full divide-y divide-stone-300">
          <thead class="bg-stone-50">
            <tr>
              <th scope="col" class="py-3.5 pr-3 pl-4 text-left text-sm font-semibold text-stone-900 sm:pl-6">Date</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-stone-900">Amount</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-stone-900">Account</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-stone-900">Category</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-stone-900">Description</th>
              <th scope="col" class="py-3.5 pr-4 pl-3 sm:pr-6">
                <span class="sr-only">Actions</span>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-200 bg-white">
            <% @transactions.each do |tran| %>
              <tr class="group/action hover:bg-stone-50">
                <td class="py-4 pr-3 pl-4 text-sm font-medium whitespace-nowrap text-stone-900 sm:pl-6"><%= word_date tran.tran_date %></td>
                <td class="px-3 py-4 text-sm whitespace-nowrap <%= tran.credit? ? "text-green-700 font-semibold" : "text-stone-500" %>"><%= number_to_currency tran.amount %></td>
                <td class="px-3 py-4 text-sm whitespace-nowrap text-stone-500"><%= tran.account.name %></td>
                <td class="px-3 py-4 text-sm whitespace-nowrap text-stone-500">
                  <%= turbo_frame_tag tran do %>
                    <% if tran.category_id? %>
                      <span class="text-sm leading-6 text-stone-500 hover:text-sky-600 group/title">
                        <%= link_to tran.category.title, edit_inline_category_transaction_url(tran, page: params[:page]), data: { role: "edit" } %>
                        <%= heroicon "pencil", class: "inline ml-1.5 size-4 invisible group-hover/title:visible", variant: :outline %>
                      </span>
                    <% else %>
                      <%= link_to "+ Add Category", edit_inline_category_transaction_url(tran, page: params[:page]), class: "link-primary", data: { role: "edit" } %>
                    <% end %>
                  <% end %>
                </td>
                <td class="px-3 py-4 text-sm text-stone-500"><%= truncate(tran.description, length: 60) %></td>
                <td class="py-4 pr-4 pl-3 sm:pr-6">
                  <div class="flex justify-end items-center text-right invisible group-hover/action:visible">
                    <button command="show-modal" commandfor="edit_<%= dom_id(tran) %>" class="link-primary hover:cursor-pointer pr-4">
                      <%= heroicon "pencil-square", class: "size-6 shrink-0" %>
                    </button>
                    <button command="show-modal" commandfor="delete_<%= dom_id(tran) %>" class="link-primary text-red-700 hover:text-red-500 hover:cursor-pointer text-sm">
                      <%= heroicon "trash", class: "size-6 shrink-0" %>
                    </button>
                  </div>
                    <el-dialog>
                      <dialog id="edit_<%= dom_id(tran) %>" aria-labelledby="edit-<%= tran.id %>-drawer-title" class="fixed inset-0 size-auto max-h-none max-w-none overflow-hidden bg-transparent not-open:hidden backdrop:bg-transparent">
                        <el-dialog-backdrop class="absolute inset-0 bg-stone-500/75 transition-opacity duration-500 ease-in-out data-closed:opacity-0"></el-dialog-backdrop>
                        <div tabindex="0" class="absolute inset-0 pl-10 focus:outline-none sm:pl-16">
                          <el-dialog-panel class="ml-auto block size-full max-w-md transform transition duration-500 ease-in-out data-closed:translate-x-full sm:duration-700">
                            <div class="relative flex h-full flex-col overflow-y-auto bg-white py-6 shadow-xl">
                              <div class="px-4 sm:px-6">
                                <div class="flex items-start justify-between">
                                  <h2 id="edit-<%= tran.id %>-drawer-title" class="text-base font-semibold text-stone-900">Edit Transaction</h2>
                                  <div class="ml-3 flex h-7 items-center">
                                    <button type="button" command="close" commandfor="edit_<%= dom_id(tran) %>" class="relative p-1 rounded-md text-stone-400 hover:text-stone-500 hover:bg-stone-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600">
                                      <span class="absolute -inset-2.5"></span>
                                      <span class="sr-only">Close panel</span>
                                      <%= heroicon "x-mark", class: "size-6" %>
                                    </button>
                                  </div>
                                </div>
                              </div>
                              <div class="relative mt-6 flex-1 px-4 sm:px-6">
                                <div>
                                  <%= form_with(model: tran, url: transaction_url(tran), scope: :transaction) do |form| %>
                                    <div class="space-y-8">
                                      <div class="mt-6 grid grid-cols-1 gap-y-6 gap-x-4">
                                        <div>
                                          <%= form.label :tran_date, "Transaction Date", class: "form-label" %>
                                          <div class="mt-1">
                                            <%= form.date_field :tran_date, max: Date.today, required: true, class: "text-field" %>
                                          </div>
                                        </div>
                                        <div>
                                          <%= form.label :category, class: "form-label" %>
                                          <div class="mt-1">
                                            <%= form.select :category_id, grouped_options_for_select(@categories.group_by(&:group_title).transform_values { |cats| cats.map { |c| [c.title, c.id] } }, tran.category_id), { include_blank: true }, required: true, class: "text-field" %>
                                          </div>
                                        </div>
                                        <div>
                                          <%= form.label :description, class: "form-label" %>
                                          <div class="mt-1">
                                            <%= form.text_field :description, required: true, class: "text-field" %>
                                          </div>
                                        </div>
                                        <div>
                                          <%= form.label :amount, class: "form-label" %>
                                          <div class="mt-1">
                                            <%= form.number_field :amount, step: 0.01, required: true, class: "text-field" %>
                                          </div>
                                        </div>
                                      </div>
                                      <div class="mt-2 space-y-6 sm:flex sm:items-center sm:space-y-0 sm:space-x-10">
                                        <div class="flex items-center">
                                          <%= form.radio_button :tran_type, "debit", checked: true, class: "relative size-4 appearance-none rounded-full border border-stone-300 bg-white before:absolute before:inset-1 before:rounded-full before:bg-white not-checked:before:hidden checked:border-sky-600 checked:bg-sky-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 disabled:border-stone-300 disabled:bg-stone-100 disabled:before:bg-stone-400 forced-colors:appearance-auto forced-colors:before:hidden" %>
                                          <label for="transaction_tran_type_debit" class="ml-3 form-label">Debit</label>
                                        </div>
                                        <div class="flex items-center">
                                          <%= form.radio_button :tran_type, "credit", class: "relative size-4 appearance-none rounded-full border border-stone-300 bg-white before:absolute before:inset-1 before:rounded-full before:bg-white not-checked:before:hidden checked:border-sky-600 checked:bg-sky-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 disabled:border-stone-300 disabled:bg-stone-100 disabled:before:bg-stone-400 forced-colors:appearance-auto forced-colors:before:hidden" %>
                                          <label for="transaction_tran_type_credit" class="ml-3 form-label">Credit</label>
                                        </div>
                                      </div>
                                      <div class="pt-5 border-t border-stone-200">
                                        <div class="flex justify-end">
                                          <%= form.submit "Save", class: "inline-flex justify-center btn btn-primary" %>
                                        </div>
                                      </div>
                                    </div>
                                  <% end %>
                                </div>
                              </div>
                            </div>
                          </el-dialog-panel>
                        </div>
                      </dialog>
                    </el-dialog>
                    <el-dialog>
                      <dialog id="delete_<%= dom_id(tran) %>" aria-labelledby="dialog-title" class="fixed inset-0 size-auto max-h-none max-w-none overflow-y-auto bg-transparent backdrop:bg-transparent">
                        <el-dialog-backdrop class="fixed inset-0 bg-stone-500/75 transition-opacity data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in"></el-dialog-backdrop>
                        <div tabindex="0" class="flex min-h-full items-end justify-center p-4 text-center focus:outline-none sm:items-center sm:p-0">
                          <el-dialog-panel class="relative transform overflow-hidden rounded-lg bg-white px-4 pt-5 pb-4 text-left shadow-xl transition-all data-closed:translate-y-4 data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in sm:my-8 sm:w-full sm:max-w-lg sm:p-6 data-closed:sm:translate-y-0 data-closed:sm:scale-95">
                            <div class="sm:flex sm:items-start">
                              <div class="mx-auto flex size-12 shrink-0 items-center justify-center rounded-full bg-red-100 sm:mx-0 sm:size-10">
                                <%= heroicon "exclamation-triangle", class: "size-6 text-red-600" %>
                              </div>
                              <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
                                <h3 id="dialog-title" class="text-base font-semibold text-stone-900">Delete transaction</h3>
                                <div class="mt-2">
                                  <p class="text-sm text-stone-500">Are you sure you want to delete this transaction? This action cannot be undone.</p>
                                </div>
                              </div>
                            </div>
                            <div class="mt-5 sm:mt-4 sm:flex sm:flex-row-reverse">
                              <%= link_to "Delete", transaction_url(tran), class: "inline-flex w-full justify-center btn btn-danger sm:ml-3 sm:w-auto", data: { turbo_method: :delete } %>
                              <button type="button" command="close" commandfor="delete_<%= dom_id(tran) %>" class="mt-3 inline-flex w-full justify-center btn btn-secondary sm:mt-0 sm:w-auto">
                                Cancel
                              </button>
                            </div>
                          </el-dialog-panel>
                        </div>
                      </dialog>
                    </el-dialog>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="flex justify-center">
  <div class="my-4 text-sm font-medium text-sky-500 hover:text-sky-700">
    <%== render partial: "shared/pagination", locals: { pagy: @pagy } %>
  </div>
</div>
