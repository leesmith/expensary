<div class="flex justify-end mb-4">
  <span class="isolate inline-flex rounded-md shadow-xs">
    <button type="button" class="relative inline-flex items-center rounded-l-md bg-white px-2 py-2 text-zinc-400 inset-ring-1 inset-ring-zinc-300 hover:bg-zinc-50 hover:cursor-pointer focus:z-10">
      <span class="sr-only">Previous</span>
      <%= heroicon "chevron-left", class: "size-5", variant: :mini %>
    </button>
    <span class="bg-white py-1 px-4 border-y-1 border-zinc-300 font-medium text-zinc-900 text-xs/7">October 2025</span>
    <button type="button" class="relative -ml-px inline-flex items-center rounded-r-md bg-white px-2 py-2 text-zinc-400 inset-ring-1 inset-ring-zinc-300 hover:bg-zinc-50 hover:cursor-pointer focus:z-10">
      <span class="sr-only">Next</span>
      <%= heroicon "chevron-right", class: "size-5", variant: :mini %>
    </button>
  </span>
</div>

<%= render "shared/card", class: "mb-5 grid grid-cols-1 divide-zinc-200 divide-y-1 md:grid-cols-3 md:divide-x md:divide-y-0" do %>
  <div class="px-4 py-5 sm:p-6 text-center">
    <div class="font-semibold text-3xl text-green-700 py-3">
      $8,440
    </div>
    <div class="text-sm/6 font-medium tracking-widest text-zinc-500 uppercase">
      Total Income
    </div>
  </div>
  <div class="px-4 py-5 sm:p-6 text-center">
    <div class="font-semibold text-3xl text-red-700 py-3">
      $7,892
    </div>
    <div class="text-sm/6 font-medium tracking-widest text-zinc-500 uppercase">
      Total Expenses
    </div>
  </div>
  <div class="px-4 py-5 sm:p-6 text-center">
    <div class="font-semibold text-3xl text-zinc-900 py-3">
      $548
    </div>
    <div class="text-sm/6 font-medium tracking-widest text-zinc-500 uppercase">
      Total Net Income
    </div>
  </div>
<% end %>
