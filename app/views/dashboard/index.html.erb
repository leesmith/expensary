<div class="flex justify-end items-center mb-4">
  <span class="isolate inline-flex rounded-md shadow-xs">
    <%= link_to "/?f=#{get_previous_month(@date_filter)}", class: "relative inline-flex items-center rounded-l-md bg-white px-2 py-2 text-stone-400 inset-ring-1 inset-ring-stone-300 hover:bg-stone-50 hover:cursor-pointer focus:z-10" do %>
      <span class="sr-only">Previous</span>
      <%= heroicon "chevron-left", class: "size-5", variant: :mini %>
    <% end %>
    <span class="bg-white py-1 px-4 border-y-1 border-stone-300 font-medium text-stone-700 text-xs/7"><%= @date_filter.strftime("%b %Y") %></span>
    <%= link_to "/?f=#{get_next_month(@date_filter)}", class: "relative -ml-px inline-flex items-center rounded-r-md bg-white px-2 py-2 text-stone-400 inset-ring-1 inset-ring-stone-300 hover:bg-stone-50 hover:cursor-pointer focus:z-10" do %>
      <span class="sr-only">Next</span>
      <%= heroicon "chevron-right", class: "size-5", variant: :mini %>
    <% end %>
  </span>
</div>

<%= render "shared/card", class: "mb-5 grid grid-cols-1 divide-stone-200 divide-y-1 md:grid-cols-4 md:divide-x md:divide-y-0" do %>
  <div class="px-4 py-5 sm:p-6 text-center">
    <div class="font-semibold text-3xl text-green-700 py-3">
      <%= number_to_currency(@dashboard.total_income, precision: 0) %>
    </div>
    <div class="text-xs/6 font-medium tracking-wider text-stone-500 uppercase">
      Total Income
    </div>
  </div>
  <div class="px-4 py-5 sm:p-6 text-center">
    <div class="font-semibold text-3xl text-red-700 py-3">
      <%= number_to_currency(@dashboard.total_expenses, precision: 0) %>
    </div>
    <div class="text-xs/6 font-medium tracking-wider text-stone-500 uppercase">
      Total Expenses
    </div>
  </div>
  <div class="px-4 py-5 sm:p-6 text-center">
    <div class="font-semibold text-3xl text-stone-900 py-3">
      <%= number_to_currency(@dashboard.cash_flow, precision: 0) %>
    </div>
    <div class="text-xs/6 font-medium tracking-wider text-stone-500 uppercase">
      Cash Flow
    </div>
  </div>
  <div class="px-4 py-5 sm:p-6 text-center">
    <div class="font-semibold text-3xl text-stone-900 py-3">
      <%= number_to_percentage(@dashboard.savings_rate, precision: 1) %>
    </div>
    <div class="text-xs/6 font-medium tracking-wider text-stone-500 uppercase">
      Savings Rate
    </div>
  </div>
<% end %>
