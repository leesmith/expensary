<%# locals: (dashboard: nil) -%>
<%= render "shared/card", class: "p-6" do %>
  <p class="text-stone-900 font-medium text-center">Top Expense Categories</p>
  <%= donut_chart dashboard.top_expense_categories,
    height: "300px",
    options: {
      legend: {
        show: false
      },
      series: {
        name: "Top Expense Categories",
        labelLine: {
          show: true
        },
        padAngle: 4,
        itemStyle: {
          borderRadius: 8
        },
        emphasis: {
          itemStyle: {
            shadowBlur: 4,
            shadowOffsetX: 0,
            shadowColor: 'rgba(0, 0, 0, 0.5)'
          }
        },
      },
      color: [
        "#ff6467",
        "#ff8904",
        "#fdc700",
        "#05df72",
        "#00bcff",
        "#a684ff",
        "#fb64b6",
      ],
    }
  %>
  <div class="pt-5 flex items-center justify-between border-t border-stone-100">
    <span class="text-sm/6 font-medium text-stone-900">Uncategorized Transactions</span>
    <span class="text-sm/6 text-stone-700"><%= dashboard.uncatorgized_trans %></span>
  </div>
<% end %>
