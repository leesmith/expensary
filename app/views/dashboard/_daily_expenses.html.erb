<%# locals: (dashboard: nil) -%>
<%= render "shared/card", class: "p-6" do %>
  <p class="text-stone-900 font-medium text-center">Daily Spending</p>
  <%= line_chart dashboard.daily_expenses,
    height: "300px",
    options: {
      color: ["#0084d1"],
      series: {
        smooth: true
      },
      toolbox: {
        show: false,
      },
    }
  %>
  <div class="pt-5 flex items-center justify-between border-t border-stone-100">
    <span class="text-sm/6 font-medium text-stone-900">Daily Average Spending</span>
    <span class="text-sm/6 text-stone-700"><%= number_to_currency(dashboard.daily_average_spending, precision: 2) %></span>
  </div>
<% end %>
