<%# locals: (sankey_chart: nil) -%>
<%= render "shared/card", class: "mb-5 p-6" do %>
  <p class="text-stone-900 font-medium text-center">Income to Expenses</p>
  <p class="text-stone-500 text-xs/6 text-center"><%= trends_time_period_display(params[:f].present? ? params[:f] : "1") %></p>
  <%= custom_chart({
    height: "850px",
    toolbox: {
      show: false
    },
    tooltip: {
      trigger: 'item',
      triggerOn: 'mousemove'
    },
    series: {
      type: 'sankey',
      layout: 'none',
      emphasis: {
        focus: 'adjacency'
      },
      data: sankey_chart.nodes,
      links: sankey_chart.links,
      levels: [
        {
          depth: 0,
          itemStyle: {
            color: '#ccebc5'
          },
          lineStyle: {
            color: 'source',
            opacity: 0.7
          }
        },
        {
          depth: 1,
          itemStyle: {
            color: '#dddddd'
          },
          lineStyle: {
            color: 'source',
            opacity: 0.7
          }
        },
        {
          depth: 2,
          itemStyle: {
            color: '#fbb4ae'
          },
          lineStyle: {
            color: 'source',
            opacity: 0.7
          }
        },
        {
          depth: 3,
          itemStyle: {
            color: '#b3cde3'
          },
          lineStyle: {
            color: 'source',
            opacity: 0.7
          }
        },
      ]
    }
  })
%>
<% end %>
