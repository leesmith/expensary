<div class="flex justify-end items-center space-x-4 mb-4">
  <div class="isolate inline-flex rounded-md shadow-xs">
    <%= link_to trends_url(f: 1, g: params[:g]), class: "relative inline-flex items-center rounded-l-md #{params[:f] == '1' ? 'bg-stone-50' : params[:f] == nil ? 'bg-stone-50' : 'bg-white'} px-2 py-2 text-stone-400 inset-ring-1 inset-ring-stone-300 hover:bg-stone-50 hover:cursor-pointer focus:z-10" do %>
      <span class="px-2 font-medium text-stone-700 text-xs/5">Last month</span>
    <% end %>
    <%= link_to trends_url(f: 3, g: params[:g]), class: "relative -ml-px inline-flex items-center #{params[:f] == '3' ? 'bg-stone-50' : 'bg-white'} px-2 py-2 text-stone-400 inset-ring-1 inset-ring-stone-300 hover:bg-stone-50 hover:cursor-pointer focus:z-10" do %>
      <span class="px-2 font-medium text-stone-700 text-xs/5">3 months</span>
    <% end %>
    <%= link_to trends_url(f: 6, g: params[:g]), class: "relative -ml-px inline-flex items-center #{params[:f] == '6' ? 'bg-stone-50' : 'bg-white'} px-2 py-2 text-stone-400 inset-ring-1 inset-ring-stone-300 hover:bg-stone-50 hover:cursor-pointer focus:z-10" do %>
      <span class="px-2 font-medium text-stone-700 text-xs/5">6 months</span>
    <% end %>
    <%= link_to trends_url(f: 12, g: params[:g]), class: "relative -ml-px inline-flex items-center #{params[:f] == '12' ? 'bg-stone-50' : 'bg-white'} px-2 py-2 text-stone-400 inset-ring-1 inset-ring-stone-300 hover:bg-stone-50 hover:cursor-pointer focus:z-10" do %>
      <span class="px-2 font-medium text-stone-700 text-xs/5">12 months</span>
    <% end %>
    <%= link_to trends_url(f: "y", g: params[:g]), class: "relative -ml-px inline-flex items-center rounded-r-md #{params[:f] == 'y' ? 'bg-stone-50' : 'bg-white'} px-2 py-2 text-stone-400 inset-ring-1 inset-ring-stone-300 hover:bg-stone-50 hover:cursor-pointer focus:z-10" do %>
      <span class="px-2 font-medium text-stone-700 text-xs/5">This year</span>
    <% end %>
  </div>
  <div class="isolate inline-flex rounded-md shadow-xs">
    <%= link_to trends_url(f: params[:f], g: "b"), class: "relative inline-flex items-center rounded-l-md #{params[:g] == 'b' ? 'bg-stone-50' : params[:g] == nil ? 'bg-stone-50' : 'bg-white'} px-2 py-2 text-stone-400 inset-ring-1 inset-ring-stone-300 hover:bg-stone-50 hover:cursor-pointer focus:z-10" do %>
      <span class="sr-only">Bar chart</span>
      <%= heroicon "chart-bar", class: "size-5", variant: :solid %>
    <% end %>
    <%= link_to trends_url(f: params[:f], g: "s"), class: "relative -ml-px inline-flex items-center rounded-r-md #{params[:g] == 's' ? 'bg-stone-50' : 'bg-white'} px-2 py-2 text-stone-400 inset-ring-1 inset-ring-stone-300 hover:bg-stone-50 hover:cursor-pointer focus:z-10" do %>
      <span class="sr-only">Sankey chart</span>
      <svg fill="#a6a09b" class="size-5" viewBox="0 0 32 32" id="icon" xmlns="http://www.w3.org/2000/svg">
        <path d="M30,2H2V16H8.1113a7.0359,7.0359,0,0,1,3.13.7393L15.7637,19l-4.522,2.2607A7.0359,7.0359,0,0,1,8.1113,22H2v8H9.2231a9.0446,9.0446,0,0,0,4.0249-.95L21.87,24.7393A7.0359,7.0359,0,0,1,25,24h5V14H25a7.0359,7.0359,0,0,1-3.13-.7393L15.3481,10H30ZM8,4H24V8H8ZM4,4H6V14H4ZM4,24H6v4H4Zm16.9751-1.05-8.6216,4.3105A7.0359,7.0359,0,0,1,9.2231,28H8V24h.1113a9.0446,9.0446,0,0,0,4.0249-.95L18,20.1182l1.8638.9316a9.0446,9.0446,0,0,0,4.0249.95H24v.0586A9.0515,9.0515,0,0,0,20.9751,22.95ZM28,22H26V16h2ZM12.3535,10.7393l8.6216,4.31A9.0515,9.0515,0,0,0,24,15.9414V20h-.1113a7.0359,7.0359,0,0,1-3.13-.7393l-8.6221-4.31A9.0446,9.0446,0,0,0,8.1113,14H8V10H9.2231A7.0359,7.0359,0,0,1,12.3535,10.7393ZM28,8H26V4h2Z"/>
        <rect style="fill: none;" width="32" height="32"/>
      </svg>
    <% end %>
  </div>
</div>

<% if params[:g].blank? || params[:g] == 'b' %>
  <%= render "bar_chart", trends: @trends %>
<% elsif params[:g] == 's' %>
  <%= render "sankey_chart", sankey_chart: @sankey_chart %>
<% end %>
