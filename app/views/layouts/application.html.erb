<!DOCTYPE html>
<html class="h-full bg-[#f1f1ee]">
  <head>
    <title><%= content_for(:title) || "Expensary" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Inter font %>
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full">
    <!-- Drawer sidebar for mobile -->
    <el-dialog>
      <dialog id="sidebar" class="backdrop:bg-transparent lg:hidden">
        <el-dialog-backdrop class="fixed inset-0 bg-stone-800/80 transition-opacity duration-300 ease-linear data-closed:opacity-0"></el-dialog-backdrop>
        <div tabindex="0" class="fixed inset-0 flex focus:outline-none">
          <el-dialog-panel class="group/dialog-panel relative mr-16 flex w-full max-w-64 flex-1 transform transition duration-300 ease-in-out data-closed:-translate-x-full">
            <div class="absolute top-0 left-full flex w-16 justify-center pt-5 duration-300 ease-in-out group-data-closed/dialog-panel:opacity-0">
              <button type="button" command="close" commandfor="sidebar" class="-m-2.5 p-2.5">
                <span class="sr-only">Close sidebar</span>
                <%= heroicon "x-mark", class: "size-6 text-white", data: { "slot" => "icon" } %>
              </button>
            </div>
            <div class="relative flex grow flex-col gap-y-5 overflow-y-auto bg-stone-800 px-6 pb-2 ring-1 ring-white/10">
              <div class="relative flex h-16 shrink-0 items-center font-semibold text-xl text-emerald-600 tracking-tighter">
                <%= heroicon "currency-dollar", class: "size-6 shrink-0 mr-1" %>
                Expensary
              </div>
              <nav class="flex flex-1 flex-col">
                <ul role="list" class="flex flex-1 flex-col gap-y-7">
                  <li>
                    <ul role="list" class="-mx-2 space-y-1">
                      <li>
                        <!-- Current: "bg-white/5 text-white", Default: "text-stone-400 hover:text-white hover:bg-white/5" -->
                        <% if request.controller_class.ancestors.include? DashboardController %>
                          <%= link_to root_path, class: "group flex gap-x-3 rounded-md bg-white/5 p-2 text-sm/6 text-white" do %>
                            <%= heroicon "home", class: "size-6 shrink-0" %>
                            Dashboard
                          <% end %>
                        <% else %>
                          <%= link_to root_path, class: "group flex gap-x-3 rounded-md p-2 text-sm/6 text-stone-400 hover:bg-white/5 hover:text-white" do %>
                            <%= heroicon "home", class: "size-6 shrink-0" %>
                            Dashboard
                          <% end %>
                        <% end %>
                      </li>
                      <li>
                        <% if request.controller_class.ancestors.include? AccountsController %>
                          <%= link_to accounts_url, class: "group flex gap-x-3 rounded-md bg-white/5 p-2 text-sm/6 text-white" do %>
                            <%= heroicon "rectangle-stack", class: "size-6 shrink-0" %>
                            Accounts
                          <% end %>
                        <% else %>
                          <%= link_to accounts_url, class: "group flex gap-x-3 rounded-md p-2 text-sm/6 text-stone-400 hover:bg-white/5 hover:text-white" do %>
                            <%= heroicon "rectangle-stack", class: "size-6 shrink-0" %>
                            Accounts
                          <% end %>
                        <% end %>
                      </li>
                      <li>
                        <% if request.controller_class.ancestors.include? TransactionsController %>
                          <%= link_to transactions_url, class: "group flex gap-x-3 rounded-md bg-white/5 p-2 text-sm/6 text-white" do %>
                            <%= heroicon "banknotes", class: "size-6 shrink-0" %>
                            Transactions
                          <% end %>
                        <% else %>
                          <%= link_to transactions_url, class: "group flex gap-x-3 rounded-md p-2 text-sm/6 text-stone-400 hover:bg-white/5 hover:text-white" do %>
                            <%= heroicon "banknotes", class: "size-6 shrink-0" %>
                            Transactions
                          <% end %>
                        <% end %>
                      </li>
                      <li>
                        <% if request.controller_class.ancestors.include? CashFlowController %>
                          <%= link_to cash_flow_url, class: "group flex gap-x-3 rounded-md bg-white/5 p-2 text-sm/6 text-white" do %>
                            <%= heroicon "chart-bar", class: "size-6 shrink-0" %>
                            Cash Flow
                          <% end %>
                        <% else %>
                          <%= link_to cash_flow_url, class: "group flex gap-x-3 rounded-md p-2 text-sm/6 text-stone-400 hover:bg-white/5 hover:text-white" do %>
                            <%= heroicon "chart-bar", class: "size-6 shrink-0" %>
                            Cash Flow
                          <% end %>
                        <% end %>
                      </li>
                      <li>
                        <% if request.controller_class.ancestors.include? CategoriesController %>
                          <%= link_to categories_url, class: "group flex gap-x-3 rounded-md bg-white/5 p-2 text-sm/6 text-white" do %>
                            <%= heroicon "tag", class: "size-6 shrink-0" %>
                            Categories
                          <% end %>
                        <% else %>
                          <%= link_to categories_url, class: "group flex gap-x-3 rounded-md p-2 text-sm/6 text-stone-400 hover:bg-white/5 hover:text-white" do %>
                            <%= heroicon "tag", class: "size-6 shrink-0" %>
                            Categories
                          <% end %>
                        <% end %>
                      </li>
                      <li>
                        <% if request.controller_class.ancestors.include? TrendsController %>
                          <%= link_to trends_url, class: "group flex gap-x-3 rounded-md bg-white/5 p-2 text-sm/6 text-white" do %>
                            <%= heroicon "arrow-trending-up", class: "size-6 shrink-0" %>
                            Trends
                          <% end %>
                        <% else %>
                          <%= link_to trends_url, class: "group flex gap-x-3 rounded-md p-2 text-sm/6 text-stone-400 hover:bg-white/5 hover:text-white" do %>
                            <%= heroicon "arrow-trending-up", class: "size-6 shrink-0" %>
                            Trends
                          <% end %>
                        <% end %>
                      </li>
                    </ul>
                  </li>
                </ul>
              </nav>
            </div>
          </el-dialog-panel>
        </div>
      </dialog>
    </el-dialog>

    <!-- Static sidebar for desktop -->
    <div class="hidden bg-stone-800 lg:fixed lg:inset-y-0 lg:z-50 lg:flex lg:w-64 lg:flex-col">
      <div class="flex grow flex-col gap-y-5 overflow-y-auto px-6">
        <div class="flex h-16 shrink-0 items-center font-semibold text-xl text-emerald-600 tracking-tighter">
          <%= heroicon "currency-dollar", class: "size-6 shrink-0 mr-1" %>
          Expensary
        </div>
        <nav class="flex flex-1 flex-col">
          <ul role="list" class="flex flex-1 flex-col gap-y-7">
            <li>
              <ul role="list" class="-mx-2 space-y-1">
                <li>
                  <% if request.controller_class.ancestors.include? DashboardController %>
                    <%= link_to root_path, class: "group flex gap-x-3 rounded-md bg-white/5 p-2 text-sm/6 text-white" do %>
                      <%= heroicon "home", class: "size-6 shrink-0" %>
                      Dashboard
                    <% end %>
                  <% else %>
                    <%= link_to root_path, class: "group flex gap-x-3 rounded-md p-2 text-sm/6 text-stone-400 hover:bg-white/5 hover:text-white" do %>
                      <%= heroicon "home", class: "size-6 shrink-0" %>
                      Dashboard
                    <% end %>
                  <% end %>
                </li>
                <li>
                  <% if request.controller_class.ancestors.include? AccountsController %>
                    <%= link_to accounts_url, class: "group flex gap-x-3 rounded-md bg-white/5 p-2 text-sm/6 text-white" do %>
                      <%= heroicon "rectangle-stack", class: "size-6 shrink-0" %>
                      Accounts
                    <% end %>
                  <% else %>
                    <%= link_to accounts_url, class: "group flex gap-x-3 rounded-md p-2 text-sm/6 text-stone-400 hover:bg-white/5 hover:text-white" do %>
                      <%= heroicon "rectangle-stack", class: "size-6 shrink-0" %>
                      Accounts
                    <% end %>
                  <% end %>
                </li>
                <li>
                  <% if request.controller_class.ancestors.include? TransactionsController %>
                    <%= link_to transactions_url, class: "group flex gap-x-3 rounded-md bg-white/5 p-2 text-sm/6 text-white" do %>
                      <%= heroicon "banknotes", class: "size-6 shrink-0" %>
                      Transactions
                    <% end %>
                  <% else %>
                    <%= link_to transactions_url, class: "group flex gap-x-3 rounded-md p-2 text-sm/6 text-stone-400 hover:bg-white/5 hover:text-white" do %>
                      <%= heroicon "banknotes", class: "size-6 shrink-0" %>
                      Transactions
                    <% end %>
                  <% end %>
                </li>
                <li>
                  <% if request.controller_class.ancestors.include? CashFlowController %>
                    <%= link_to cash_flow_url, class: "group flex gap-x-3 rounded-md bg-white/5 p-2 text-sm/6 text-white" do %>
                      <%= heroicon "chart-bar", class: "size-6 shrink-0" %>
                      Cash Flow
                    <% end %>
                  <% else %>
                    <%= link_to cash_flow_url, class: "group flex gap-x-3 rounded-md p-2 text-sm/6 text-stone-400 hover:bg-white/5 hover:text-white" do %>
                      <%= heroicon "chart-bar", class: "size-6 shrink-0" %>
                      Cash Flow
                    <% end %>
                  <% end %>
                </li>
                <li>
                  <% if request.controller_class.ancestors.include? CategoriesController %>
                    <%= link_to categories_url, class: "group flex gap-x-3 rounded-md bg-white/5 p-2 text-sm/6 text-white" do %>
                      <%= heroicon "tag", class: "size-6 shrink-0" %>
                      Categories
                    <% end %>
                  <% else %>
                    <%= link_to categories_url, class: "group flex gap-x-3 rounded-md p-2 text-sm/6 text-stone-400 hover:bg-white/5 hover:text-white" do %>
                      <%= heroicon "tag", class: "size-6 shrink-0" %>
                      Categories
                    <% end %>
                  <% end %>
                </li>
                <li>
                  <% if request.controller_class.ancestors.include? TrendsController %>
                    <%= link_to trends_url, class: "group flex gap-x-3 rounded-md bg-white/5 p-2 text-sm/6 text-white" do %>
                      <%= heroicon "arrow-trending-up", class: "size-6 shrink-0" %>
                      Trends
                    <% end %>
                  <% else %>
                    <%= link_to trends_url, class: "group flex gap-x-3 rounded-md p-2 text-sm/6 text-stone-400 hover:bg-white/5 hover:text-white" do %>
                      <%= heroicon "arrow-trending-up", class: "size-6 shrink-0" %>
                      Trends
                    <% end %>
                  <% end %>
                </li>
              </ul>
            </li>
          </ul>
        </nav>
      </div>
    </div>

    <div class="sticky top-0 z-40 flex items-center gap-x-6 bg-stone-800 px-4 py-4 shadow-sm sm:px-6 lg:hidden">
      <button type="button" command="show-modal" commandfor="sidebar" class="-m-2.5 p-2.5 text-stone-400 hover:text-white lg:hidden">
        <span class="sr-only">Open sidebar</span>
        <%= heroicon "bars-3", class: "size-6", data: { "slot" => "icon" } %>
      </button>
      <div class="flex-1 text-sm/6 font-semibold text-white">Dashboard</div>
    </div>

    <main class="py-5 lg:pl-64">
      <div class="px-4 sm:px-6 lg:px-8">
        <%= render "shared/flash_messages" %>
        <%= yield %>
      </div>
    </main>
  </body>
</html>
